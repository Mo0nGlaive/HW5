{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowConsoleNavigation",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::*"
        },
        {
            "Sid": "AllowListSpecificBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::moon-glaive-test-137972146831-eu-central-1-an"
        },
        {
            "Sid": "AllowActionsInsideSpecificBucket",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::moon-glaive-test-137972146831-eu-central-1-an/*"
        }
    ]
}