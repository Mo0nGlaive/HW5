[master]
jenkins_master ansible_host=${master_public_ip} ansible_user=ubuntu

[worker]
jenkins_worker ansible_host=${worker_public_ip} ansible_user=ubuntu jenkins_master_private_ip=${master_private_ip}

[all:vars]
ansible_ssh_private_key_file=${private_key_path}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
