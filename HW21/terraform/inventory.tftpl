[nginx]
%{ for index, instance in instances ~}
nginx-${index + 1} ansible_host=${instance.public_ip} ansible_user=ubuntu ansible_ssh_private_key_file=${private_key_path} ansible_python_interpreter=/usr/bin/python3
%{ endfor ~}

[nginx:vars]
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
